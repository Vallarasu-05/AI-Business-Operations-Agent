APP_ENV=development

# DATA_MODE: mock | live_readonly | live_write
DATA_MODE=mock

# Leave LLM_API_KEY empty to run fully offline with the deterministic analyzer.
# LLM_PROVIDER: google | openai   (check your provider for current model names)
LLM_PROVIDER=google
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# DATABASE_URL empty = local SQLite file in /outputs
DATABASE_URL=
# VECTOR_BACKEND: memory | qdrant
VECTOR_BACKEND=memory
VECTOR_DB_URL=http://localhost:6333
USE_POSTGRES_CHECKPOINTER=false

INTERNAL_DOMAIN=mycompany.com
# If set, API requests must send header X-API-Key
API_KEY=

# Live Google. One-time login: python -m app.integrations.google.auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SHEET_ID=

HUBSPOT_ACCESS_TOKEN=
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_SECRET=change_me
# Tavily key for live web search
WEB_SEARCH_API_KEY=

LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=ai-business-operations-agent
