FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
# Proxy API calls to the backend container
RUN printf 'server {\n listen 80;\n location /api/ { proxy_pass http://backend:8000; }\n location / { root /usr/share/nginx/html; try_files $uri /index.html; }\n}\n' > /etc/nginx/conf.d/default.conf
